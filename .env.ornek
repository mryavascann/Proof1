# proof1 · örnek ortam dosyası. Kopyala: .env  (depoya girmez). Değerleri yalnız insan doldurur.

# OKX TR · ana hesap (yalnız okuma) — çekim/yatırma/fonlama kaydı burada
OKX_TR_ANA_API_KEY=
OKX_TR_ANA_SECRET_KEY=
OKX_TR_ANA_PASSPHRASE=
# OKX TR · alt hesap (yalnız okuma) — botlar, işlem defteri, test işlemleri burada
OKX_TR_ALT_API_KEY=
OKX_TR_ALT_SECRET_KEY=
OKX_TR_ALT_PASSPHRASE=
# Boş bırakılırsa ATK profil klasörleri kullanılır (içerikleri ekrana basılmaz):
OKX_TR_ANA_PROFIL=           # ör. C:\Users\<ad>\okx-ana
OKX_TR_ALT_PROFIL=           # ör. C:\Users\<ad>\okx-atk

# OnchainOS
ONCHAINOS_API_KEY=
ONCHAINOS_SECRET_KEY=
ONCHAINOS_PASSPHRASE=
ONCHAINOS_PROJECT_ID=        # portal gösteriyorsa

# Zincir
ETHERSCAN_API_KEY=           # ücretsiz; etherscan.io/myapikey (yoksa Routescan/RPC yolu)

# Telegram
TELEGRAM_BOT_TOKEN=          # BotFather /newbot
TELEGRAM_CHAT_ID=            # bota /start yazıldıktan sonra: python -m calistir.telegram_kimlik

# Sunum bilgisayarında Merve'nin parçaları da çalışacağı için:
ANTHROPIC_API_KEY=
PROOF1_FUJI_PRIVATE_KEY=     # yalnız Fuji test cüzdanı
PANO_URL=http://localhost:3003

# Ortak veri dosyası ve anlatıcı bağlantısı (ortak/SOZLESME.md)
PROOF1_DB=data/proof1.db
ANLATICI_KOMUT=              # Merve'nin anlatıcısı; {oturum} yer tutucusu verilir. Boşsa kalıp cümle.
